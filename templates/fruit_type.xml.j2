<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    FS25 Fruit Type Definition
    Generated by FS25 Crop Maker  –  https://github.com/zhult18/FS25_Crop-maker
    Crop  : {{ crop.name }}
    Preset: {{ crop.preset }}

    Instructions
    ============
    1. Copy this file into your mod's "crops/" folder.
    2. Replace the placeholder textures in "crops/textures/" with your artwork.
    3. Add the <fruitType> entry from modDesc_entry.xml to your modDesc.xml.
    4. Adjust growth states, harvest settings and ground requirements as needed.
-->
<fruitType
    name="{{ crop.name }}"
    title="$l10n_fruitName_{{ crop.name }}"
    hideFromTip="false"
    windParameters="{{ crop.windParameters }}"
    maxCurvingAngle="{{ crop.maxCurvingAngle }}"
    maxCurvingFrequency="{{ crop.maxCurvingFrequency }}"
    windRotation="{{ crop.windRotation }}"
    densityBitmask="{{ crop.densityBitmask }}"
>

    <!-- ===== FOLIAGE ===================================================== -->
    <foliage
        shaderFilename="$data/shaders/fruitShader.xml"
        atlasSize="{{ crop.atlasSize }}"
        textureFilename="crops/textures/{{ crop.name }}_DIFFUSE.png"
        normalFilename="crops/textures/{{ crop.name }}_NORMAL.png"
        roughnessFilename="crops/textures/{{ crop.name }}_ROUGHNESS.png"
        spriteSize="1"
        spriteRandom="0.3"
        spriteRandomHeightOffset="0.2"
        numStatesByMask="true"
        useRandomGrowthState="false"
    />

    <!-- ===== WIND (tuned per preset) ===================================== -->
    <windParams
        scale="1"
        frequency="1"
        influence="0.6"
        firstLastFlutter="0.3 0.6"
    />

    <!-- ===== HARVEST ===================================================== -->
    <harvest
        fractionName="{{ crop.harvestFraction }}"
        swathWidth="{{ crop.swathWidth }}"
        fruitFreeGrowing="false"
        literPerSqm="4.5"
        windrowed="false"
    />

    <!-- ===== DESTRUCTION ================================================= -->
    <destruction
        shaderFilename="$data/shaders/fruitDestructionShader.xml"
        textureFilename="crops/textures/{{ crop.name }}_DIFFUSE.png"
        normalFilename="crops/textures/{{ crop.name }}_NORMAL.png"
        atlasSize="{{ crop.atlasSize }}"
    />

    <!-- ===== CLODS (soil surface after harvesting) ======================= -->
    <clods density="0.1"/>

    <!-- ===== GROUND REQUIREMENTS ========================================= -->
    <!--  Adjust fertiliser and pH requirements to suit your crop.          -->
    <groundRequirements
        needsSeeding="true"
        needsFertilizing="true"
        minPh="6.0"
        maxPh="7.5"
        minNitrogen="0"
        needsPlowing="false"
    />

    <!-- ===== GROWTH ====================================================== -->
    <!--
        numStates              : total growth states (0 = bare soil)
        firstFruitStateIndex   : state index when fruit first appears
        minHarvestingGrowthState / maxHarvestingGrowthState : harvest window
    -->
    <growth
        numStates="{{ crop.numGrowthStates }}"
        firstFruitStateIndex="{{ crop.firstFruitStateIndex }}"
        minHarvestingGrowthState="{{ crop.minHarvestingGrowthState }}"
        maxHarvestingGrowthState="{{ crop.maxHarvestingGrowthState }}"
        witheredState="{{ crop.numGrowthStates }}"
        plantedState="1"
    />

    <!-- ===== WEED ======================================================== -->
    <weed enabled="true"/>

    <!-- ===== TYPE DESCRIPTION ============================================ -->
    <typeDesc
        filename="crops/{{ crop.name }}.xml"
        fruitTypeIndex="0"
    />

</fruitType>
